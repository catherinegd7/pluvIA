# Copia este archivo como .env y pega los datos que te pase quien hizo la base de datos.
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# true = usa datos de demostración aunque haya credenciales (útil para presentar sin internet)
VITE_USE_MOCK=false
